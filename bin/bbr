#!/usr/bin/env ruby

require 'pathname'
require 'optparse'

# Rubyライブラリの場所を解決 (このスクリプトの親の親/lib)
# これで ~/work/bbr/bin/bbr がどこから呼ばれても lib を読み込めます
lib_dir = Pathname.new(__dir__).parent.join('lib')
$LOAD_PATH.unshift(lib_dir.to_s)

require 'bbr/context'
require 'bbr/manager'
require 'bbr/builder'
require 'bbr/server'
require 'bbr/database'

# ブログデータの場所を確認
unless ENV['BBR_REPO']
  puts "エラー: 環境変数 BBR_REPO が設定されていません。"
  exit 1
end

context = Bbr::Context.new(ENV['BBR_REPO'])

# コマンド分岐
command = ARGV.shift
manager = Bbr::Manager.new(context)
server = Bbr::Server.new(context)

# オプション解析
options = {
  force: false,
  update: false,
  image_mode: :normal,
  verbose: false,
  id: nil
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bbr [command] [options]"

  # test用
  opts.on("-f", "--force", "Force build (Update date & Regen images)") { options[:force] = true }
  opts.on("-u", "--update", "Update build (Keep date & Incr images)") { options[:update] = true }
  opts.on("--fast", "Fast build (Use fatimage, Skip optimize)") { options[:image_mode] = :fat }

  # 共通
  opts.on("-v", "--verbose", "Show detailed logs") { options[:verbose] = true }
end

# 内部コマンド: サーバープロセス実行
if command == '_server'
  server.run_foreground
  exit
end

case command
when 'prev'
  # サーバー起動確認 & 起動
  server.start_background
  
  # 対象ID特定 (ブラウザを開くため)
  remaining_args = parser.parse(ARGV)
  id_arg = remaining_args.find { |arg| arg =~ /^\d+$/ }
  target_id = id_arg || manager.get_current_path&.basename&.to_s
  
  if target_id
    server.open_browser(target_id)
  else
    puts "記事が開かれていません。ブラウザを開くには bbr set してから実行してください。"
  end

when 'stop'
  server.stop

when 'test'
  remaining_args = parser.parse(ARGV)
  id_arg = remaining_args.find { |arg| arg =~ /^\d+$/ }

  require 'bbr/repository'
  repo = Bbr::Repository.new(context)
  article = id_arg ? repo.find(id_arg) : repo.current

  unless article
    puts "エラー: 対象記事が特定できません。"
    exit 1
  end

  options[:id] = article.id

  # --- V1 対話ロジック ---
  # オプション指定がない場合のみチェック
  if !options[:force] && !options[:update] && options[:image_mode] == :normal
    db = Bbr::Database.new(context.database_path)
    if db.get_record(article.id)
      puts "過去のビルドが存在します。"
      puts "[C]ancel  : 中止"
      puts "[F]orce   : 強制ビルド (日付更新 + 画像全再生成)"
      puts "[U]pdate  : 更新ビルド (日付維持 + 画像増分)"
      print "どうしますか？ [C/f/u]: "
      ans = $stdin.gets.chomp.downcase

      case ans
      when 'f'
        options[:force] = true
        puts "-> Force Build"
      when 'u'
        options[:update] = true
        puts "-> Update Build"
      else
        puts "キャンセルしました。"
        exit
      end
    else
      # レコードがない場合は新規扱い（Force相当だがメッセージは出さない）
      options[:force] = true
    end
  end
  # ---

  Bbr::Builder.new(context).build(options)

when 'clean'
  require 'bbr/repository'
  repo = Bbr::Repository.new(context)
  article = repo.current
  unless article
    puts "エラー: 対象記事が特定できません。"
    exit 1
  end

  require 'bbr/image_optimizer'
  optimizer = Bbr::ImageOptimizer.new(article.path)
  optimizer.clean

when 'deploy'
  require 'bbr/deployer'
  remaining_args = parser.parse(ARGV)
  id_arg = remaining_args.find { |arg| arg =~ /^\d+$/ }
  options[:id] = id_arg if id_arg

  Bbr::Deployer.new(context).deploy(options)

# === 管理コマンド ===
when 'new'
  manager.create_new
when 'set'
  id = ARGV.shift
  if id.nil?
    puts "エラー: 記事番号を指定してください"
    exit 1
  end
  manager.set_article(id)
when 'status'
  manager.show_status
when 'edit'
  manager.edit_article
when 'dir'
  manager.open_directory
when 'pwd'
  path = manager.get_current_path
  puts path if path
else
  puts "使用法: bbr [new|set|status|edit|dir|pwd|test|clean|prev|stop|deploy]"
end
